# .env — 실제 파일은 <repo>/.env 에 두고 채운다 (이미 .gitignore 됨).
# systemd 가 EnvironmentFile= 로 읽고, 수동 실행 시엔 bot/config.py 가 best-effort 로 읽음.

# Discord 봇 토큰 (필수) — Developer Portal → Application → Bot → Reset Token
BOT_TOKEN=

# Gemini API 키 (필수) — 쉼표로 여러 개 가능(429 시 자동 전환). 없으면 repo 의 GEMINI_API_KEY.md 도 읽음.
GEMINI_API_KEYS=

# Google Safe Browsing API 키 (필수) — /watch·/preview(처음 보는 사이트) 직전 URL 게이트의 악성 URL 검사용.
#   비어 있으면 게이트가 fail-closed 라 신규 등록이 전부 거부됨(이미 등록된 사이트 폴링·알림은 영향 없음).
#   발급: https://console.cloud.google.com → 프로젝트 → "API 및 서비스" → Safe Browsing API 사용 설정 → 사용자 인증 정보 → API 키 만들기
#         → 만든 키를 "API 제한"에서 Safe Browsing API 로만 제한(권장). billing 계정 불필요(v4 무료, 비상업 한정).
#   주의: 값만 적기 — 인라인 주석(KEY=값 # ...)은 파서가 지원 안 함.
SAFE_BROWSING_API_KEY=

# Firecrawl API 키 (선택) — register.py 의 post-probe fallback (사용자가 부정확한 URL = 도메인 root 등 던졌을 때
#   `/map` 호출해 후보 board page list 회복, 1회 retry). 없으면 fallback 비활성 (register 정상 동작 — 그냥 FAILED 로).
#   발급: https://firecrawl.dev → dashboard → API Keys. free tier = 500 credit/월. 1 credit / `/map` 호출.
FIRECRAWL_API_KEY=

# 에러 발생 시 트레이스백을 DM 받을 Discord 유저 ID (선택, 강력 권장)
#   Discord 설정 → 고급 → 개발자 모드 ON → 내 프로필 우클릭 → "사용자 ID 복사"
OWNER_USER_ID=

# 슬래시 명령을 즉시 등록할 길드(서버) ID (선택). 비우면 글로벌 등록(전파에 ~1시간).
GUILD_ID=

# Gemini 모델 (선택, 기본 gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Healthchecks.io 등 데드맨 스위치 ping URL (선택) — poll_and_notify.py 가 시작(/start)/끝/실패(/fail)에 GET
# HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx

# (Arch 에서 Playwright 번들 chromium 이 라이브러리 부족으로 안 뜨면 — env 아니라 pacman 으로 의존성 설치:
#  sudo pacman -S nss nspr at-spi2-core libcups libdrm libxkbcommon libxcomposite libxdamage libxrandr mesa pango cairo alsa-lib
#  자세한 건 docs/배포 가이드.md)
