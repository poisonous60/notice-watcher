# 매시 :20(±2분) KST 폴링 (ADR 0006 — 발송 시각 분리. 폴링은 새 글을 posts 캐시에 모으고
#   봇 내부 1분 tick(delivery_tick)이 사용자 발송 시각에 deliver_due.py 로 요약·필터·발송).
# 시간당 폴링 = 사용자마다 흩어진 발송 시각에 신선한 데이터 공급. (realtime 즉시 발송 폐지.)
# notify_empty('새 공지 없음') 도 발송창에서 처리 — 폴링 시각과 분리됨.
[Unit]
Description=Run notice poll hourly (:20 KST) — ADR 0006

[Timer]
OnCalendar=*-*-* *:20:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
