# Discord 봇 (게이트웨이 상주, 슬래시 명령 수신). 아웃바운드만 — 인바운드 포트 없음.
# 설치: sudo cp deploy/notice-bot.service /etc/systemd/system/  (경로/User 를 본인 환경에 맞게 수정)
#       sudo systemctl daemon-reload && sudo systemctl enable --now notice-bot.service
# 로그: journalctl -u notice-bot -f
[Unit]
Description=Notice Discord bot (gateway, slash commands)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/notice-watcher
EnvironmentFile=/home/<user>/notice-watcher/.env
ExecStart=/home/<user>/notice-watcher/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
# 메모리 폭주 방지 — cgroup limit. 넘으면 kernel global OOM 대신 *이 service 만* OOM-kill 후
# Restart=on-failure 가 재기동 (다른 system process 보호: tailscaled 등). 2026-05-24 박힘 —
# probe.py Phase 9b heavy SPA (podcastindex.org) 가 python RSS 7.5GB 폭주시켜 N100 12GB
# kernel global OOM 발동 + tailscaled victim. probe.py:_start_memory_guard (3.5GB self-kill)
# 가 1차 방어선이지만 그게 *못 잡는* 갑작스런 누적도 cgroup 이 받친다.
MemoryMax=10G

[Install]
WantedBy=multi-user.target
