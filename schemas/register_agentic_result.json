{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "register_agentic_result",
  "description": "Final agent_message JSON for register agentic mode. Parent re-validates `config` independently before atomic publish.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ok", "config", "attempts", "stop_reason"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "stop_reason": {
      "type": "string",
      "enum": ["validate_pass", "max_cycles", "agent_gave_up", "error"]
    }
  }
}
