{
  "version": 1,
  "site": "www.fate-go.jp",
  "board": "news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ja,en;q=0.8"
  },
  "timeout": 15,
  "polite_sleep": {"min": 2, "max": 4},
  "list": {
    "url_template": "https://news.fate-go.jp/",
    "pagination": {"kind": "none"},
    "row_selector": "ul.list_news > li",
    "include_notices": true,
    "fields": {
      "post_id": [
        {"from": "css", "selector": "a", "attr": "href", "transform": [["regex_extract", "/(\\d{4}/\\d{2}/[^/]+)/?"]]}
      ],
      "title": [
        {"from": "css", "selector": "p.title", "text": true, "transform": [["collapse_ws"]]}
      ],
      "url": [
        {"from": "css", "selector": "a", "attr": "href", "transform": [["urljoin", "https://news.fate-go.jp/"]]}
      ],
      "published_at": [
        {"from": "css", "selector": "p.date", "text": true, "transform": [["regex_extract", "(\\d{4}\\.\\d{2}\\.\\d{2})"]]}
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {"from": "css", "selector": "main", "html": true},
      {"from": "css", "selector": ".article", "html": true}
    ]
  },
  "_source_url": "https://www.fate-go.jp/news/",
  "_note": "Fate/Grand Order 공식 — 사용자 입력 URL (www.fate-go.jp/news/) 은 cloudfront 301 → home redirect 라 실 데이터 없음. canonical = news.fate-go.jp/ (list page) + news.fate-go.jp/<YYYY>/<MM>/<slug>/ (article). slug 보존 (host_fate-go-jp_news_92f8d1f5) + data fetch 는 canonical 도메인. agentic stealth DNS race 도 우회 (httpx_html 사용). 2026-05-27 hand-config 잔여."
}
