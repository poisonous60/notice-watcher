{
  "version": 1,
  "site": "canada.ca",
  "board": "advanced-news-search",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://www.canada.ca/en/news.html"
  },
  "timeout": 25,
  "headless": true,
  "nav_timeout_ms": 60000,
  "idle_timeout_ms": 5000,
  "quiet_ms": 700,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.canada.ca/en/news/advanced-news-search/news-results.html",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main article.item",
    "row_required_selector": "h3 a[href*='/news/'][href$='.html']",
    "wait_selector": "main article.item h3 a",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "h3 a",
          "attr": "href",
          "transform": [
            ["strip_query_fragment"],
            ["regex_extract", "https://www\\.canada\\.ca/en/(.+)\\.html$"]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h3 a",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "h3 a",
          "attr": "href",
          "transform": [["strip_query_fragment"]]
        }
      ],
      "published_at": [
        {
          "from": "attr",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [["date_only_to_iso", "-04:00"]]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "p",
          "text": true,
          "transform": [
            ["regex_extract", "\\|\\s*([^|]+?)\\s*\\|", 1],
            ["collapse_ws"]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "p",
          "text": true,
          "transform": [
            ["regex_extract", "\\|\\s*[^|]+?\\s*\\|\\s*(.+)$", 1],
            ["collapse_ws"]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "p:nth-of-type(2)",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "wait_selector": "main",
    "content": [
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "_source_url": "https://www.canada.ca/en/news.html",
  "_note": "handcrafted: submitted /en/news.html is a services landing page, so generic probing picked navigation such as /en/services/jobs.html. The actual news board is the Canada.ca advanced news search results page rendered as article.item rows; use playwright_html for list and article pages."
}
