{
  "version": 1,
  "site": "github.com",
  "board": "ollama/ollama",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9",
    "Referer": "https://github.com/ollama/ollama/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 1
  },
  "list": {
    "url_template": "https://github.com/ollama/ollama/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "div[data-hpc] > section",
    "row_required_selector": "h2.sr-only + div .markdown-body, h2.sr-only + div .Box",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "div.flex-1 span.tmp-mr-3.f1.text-bold.d-inline a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "div.flex-1 span.tmp-mr-3.f1.text-bold.d-inline a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "div.flex-1 span.tmp-mr-3.f1.text-bold.d-inline a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "div.mb-md-2.tmp-mr-3.tmp-mr-md-0.tmp-pt-1.tmp-pt-sm-0 a[href^='/apps/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "span.Label--success, span.Label--warning",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body.tmp-my-3",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.markdown-body[data-test-selector='body-content']",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.markdown-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "div.flex-1 span.tmp-mr-3.f1.text-bold.d-inline a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ]
    }
  }
}
