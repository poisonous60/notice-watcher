{
  "version": 1,
  "site": "circleci.com",
  "board": "changelog",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xml,text/xml;q=0.9,text/html;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://circleci.com/changelog/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://circleci.com/changelog.rss",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "/changelog/([^/]+)/?"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "template",
          "value": "changelog"
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.entry-content",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%d %H:%M:%S %z"
              ]
            ]
          ]
        }
      ]
    }
  },
  "_slug_board": "changelog",
  "_source_url": "https://circleci.com/changelog/",
  "_note": "CircleCI changelog exposes a stable RSS feed at /changelog.rss. The failed generated HTML config scoped rows too narrowly around entry-title/type-h3; RSS provides stable item/title/link/guid/pubDate/description, while article pages expose div.entry-content for full body. robots.txt has no Crawl-Delay and does not disallow /changelog/ or /changelog.rss; config keeps conservative 5-6s polite_sleep."
}
