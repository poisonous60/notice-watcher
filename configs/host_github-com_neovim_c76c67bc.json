{
  "version": 1,
  "site": "github.com",
  "board": "neovim/neovim",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://github.com/neovim/neovim/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 2
  },
  "list": {
    "url_template": "https://github.com/neovim/neovim/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "include_notices": true,
    "row_selector": "div[data-hpc] > section",
    "row_required_selector": "a[href*='/releases/tag/']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)"
            ],
            [
              "strip"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "a[href^='/apps/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "a[href*='/tree/'] span",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body.tmp-my-3",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.Box-body .markdown-body",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.Box-body",
        "html": true
      }
    ]
  }
}
