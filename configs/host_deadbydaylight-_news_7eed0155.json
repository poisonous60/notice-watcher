{
  "version": 1,
  "site": "deadbydaylight.com",
  "board": "news",
  "strategy": "playwright_html",
  "disable_stealth": true,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,application/json;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7",
    "Referer": "https://deadbydaylight.com/news/",
    "Origin": "https://deadbydaylight.com"
  },
  "timeout": 15,
  "nav_timeout_ms": 20000,
  "idle_timeout_ms": 12000,
  "quiet_ms": 800,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://deadbydaylight.com/news/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.article-card:has(a[href^='/news/'])",
    "wait_selector": "div.article-card:has(a[href^='/news/'])",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href^='/news/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/news/([^/?#]+)/?"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href^='/news/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href^='/news/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://deadbydaylight.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://deadbydaylight.com/page-data/news/{post_id}/page-data.json",
    "fetch_kind": "json",
    "data_path": [
      "result",
      "data",
      "pageData"
    ],
    "content": [
      {
        "from": "json",
        "path": [
          "content"
        ]
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "json",
          "path": [
            "title"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
