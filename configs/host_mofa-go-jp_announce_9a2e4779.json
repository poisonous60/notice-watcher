{
  "version": 1,
  "site": "mofa.go.jp",
  "board": "press-release",
  "strategy": "httpx_html",
  "_source_url": "https://www.mofa.go.jp/announce/index.html",
  "_note": "anti-bot/deprecated announce index workaround: /announce/index.html and /announce/announce/index.html are blocked or archive-like from plain httpx, and no /announce.rdf feed exists. The current official English press release index is /press/release/index.html and is static HTTP.",
  "headers": {
    "User-Agent": "Mozilla/5.0",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9,ko;q=0.7",
    "Referer": "https://www.mofa.go.jp/announce/index.html"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 5,
    "max": 5
  },
  "list": {
    "url_template": "https://www.mofa.go.jp/press/release/index.html",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main ul.link-list > li > a[href*='/press/release/pressite_']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/press/release/([^/?#]+)\\.html$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.mofa.go.jp/press/release/index.html"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "template",
          "value": "press-release"
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div#main",
        "html": true
      },
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "div#main",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "([A-Z][a-z]+ \\d{1,2}, \\d{4})"
            ],
            [
              "iso8601",
              [
                "%B %d, %Y"
              ],
              "+09:00"
            ]
          ]
        }
      ]
    }
  }
}
