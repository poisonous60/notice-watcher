{
  "version": 1,
  "site": "www.swift.org",
  "board": "blog",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "application/atom+xml,application/xml;q=0.9,text/xml;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://www.swift.org/atom.xml",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "entry",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "id",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/blog/([^/]+)/?$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "html_unescape"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "link",
          "attr": "href"
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "updated",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "content",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "section#post .details",
        "html": true
      },
      {
        "from": "css",
        "selector": "main article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "section#post h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "section#post time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ]
    }
  }
}
