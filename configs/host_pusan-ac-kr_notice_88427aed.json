{
  "version": 1,
  "site": "www.pusan.ac.kr",
  "board": "notice",
  "strategy": "playwright_html",
  "headless": false,
  "nav_timeout_ms": 30000,
  "idle_timeout_ms": 8000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9",
    "Referer": "https://www.pusan.ac.kr/"
  },
  "list": {
    "url_template": "https://www.pusan.ac.kr/kor/CMS/Board/Board.do?mCode=MN095",
    "pagination": {"kind": "none"},
    "wait_selector": "td.subject a[href*='board_seq=']",
    "row_selector": "table tbody tr",
    "row_required_selector": "td.subject a[href*='board_seq=']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {"from": "attr", "selector": "td.subject a[href*='board_seq=']", "attr": "href", "transform": [["regex_extract", "board_seq=(\\d+)"]]}
      ],
      "title": [
        {"from": "css", "selector": "td.subject a[href*='board_seq=']", "text": true, "transform": [["collapse_ws"]]}
      ],
      "url": [
        {"from": "attr", "selector": "td.subject a[href*='board_seq=']", "attr": "href", "transform": [["urljoin", "https://www.pusan.ac.kr/kor/CMS/Board/Board.do?mCode=MN095"]]}
      ],
      "author": [
        {"from": "css", "selector": "td.writer", "text": true, "transform": [["collapse_ws"]]}
      ],
      "published_at": [
        {"from": "css", "selector": "td.date", "text": true, "transform": [["date_only_to_iso", "+09:00"]]}
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {"from": "css", "selector": "div#boardContents", "html": true}
    ]
  },
  "_source_url": "https://www.pusan.ac.kr/notice",
  "_note": "Catalog /notice closed unexpectedly/404. The official representative notice board is /kor/CMS/Board/Board.do?mCode=MN095."
}
