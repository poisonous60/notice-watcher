{
  "version": 1,
  "site": "animenewsnetwork.com",
  "board": "2026/spring",
  "_source_url": "https://www.animenewsnetwork.com/encyclopedia/releases.php",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.0",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://www.animenewsnetwork.com/preview-guide/2026/spring/.234640"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 2,
    "max": 3
  },
  "list": {
    "url_template": "https://www.animenewsnetwork.com/preview-guide/2026/spring/.234640",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "ul > li.not_recent",
    "row_required_selector": "a[href*='/preview-guide/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href*='/preview-guide/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/\\.(\\d+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href*='/preview-guide/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href*='/preview-guide/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.animenewsnetwork.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.maincontent.views.article div.KonaBody",
        "html": true
      },
      {
        "from": "css",
        "selector": "div#content-zone div.KonaBody",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.KonaBody",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "#page_header",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "#page-title small time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ]
    }
  }
}
