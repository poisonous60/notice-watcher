{
  "version": 1,
  "site": "brunch.co.kr",
  "board": "@@2MrI",
  "strategy": "httpx_html",
  "_slug_board": "springboot",
  "_source_url": "https://brunch.co.kr/@springboot",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://brunch.co.kr/@springboot"
  },
  "timeout": 20,
  "list": {
    "url_template": "https://brunch.co.kr/rss/{board}",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/@@[^/]+/(\\d+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "strip"
            ],
            [
              "replace",
              "https://brunch.co.kr/@@2MrI/",
              "https://brunch.co.kr/@springboot/"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S GMT"
              ],
              "Z"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "regex_extract",
              "<img[^>]+src=\\s*[\"']?([^\"' >]+)"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": ".wrap_body",
        "html": true
      },
      {
        "from": "css",
        "selector": "body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "meta[property='og:title']",
          "attr": "content",
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "_note": "handcrafted after register timeout bug fix: Brunch profile exposes an alternate RSS URL using the real author id @@2MrI. RSS list uses httpx_html; article pages redirect from @springboot/{id} and expose .wrap_body statically.",
  "_recognized_platform": "host_brunch-co-kr"
}
