{
  "version": 1,
  "site": "forum.lazarus.freepascal.org",
  "board": "recent",
  "strategy": "playwright_html",
  "nav_timeout_ms": 30000,
  "idle_timeout_ms": 14000,
  "headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"},
  "list": {
    "url_template": "https://forum.lazarus.freepascal.org/index.php?action=recent",
    "pagination": {"kind": "none"},
    "wait_selector": "div.topic_details a[href*='topic=']",
    "row_selector": "div.topic_details",
    "row_required_selector": "a[href*='topic=']",
    "include_notices": true,
    "fields": {
      "post_id": [{"from": "attr", "selector": "a[href*='topic=']", "attr": "href", "transform": [["regex_extract", "topic=(\\d+)"]]}],
      "title": [{"from": "css", "selector": "a[href*='topic=']", "text": true, "transform": [["collapse_ws"]]}],
      "url": [{"from": "attr", "selector": "a[href*='topic=']", "attr": "href", "transform": [["urljoin", "https://forum.lazarus.freepascal.org/"]]}]
    }
  },
  "article": {"fetch_kind": "html", "content": [], "body_empty_acceptable": true},
  "_source_url": "https://forum.lazarus.freepascal.org/",
  "_note": "Lazarus 포럼(SMF) — Anubis PoW anti-bot 라 httpx 차단. 헤드리스 브라우저가 PoW 통과 → playwright_html. action=recent 최근 글, row=div.topic_details, post_id=topic."
}
