{
  "version": 1,
  "site": "archlinux.org",
  "board": "news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xml,text/xml,*/*;q=0.9",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://archlinux.org/news/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 2,
    "max": 2
  },
  "list": {
    "url_template": "https://archlinux.org/feeds/{board}/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "https?://archlinux\\.org/news/([^/]+)/?"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "https?://archlinux\\.org/news/([^/]+)/?"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %Z",
                "%a, %d %b %Y %H:%M:%S %z"
              ],
              "Z"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "creator",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "author",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://archlinux.org/news/{post_id}/",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main .article-content",
        "html": true
      },
      {
        "from": "css",
        "selector": "article .article-content",
        "html": true
      },
      {
        "from": "css",
        "selector": ".article-content",
        "html": true
      },
      {
        "from": "css",
        "selector": "main article",
        "html": true
      },
      {
        "from": "css",
        "selector": "article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h2",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
