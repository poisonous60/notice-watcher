{
  "version": 1,
  "site": "wynncraft.com",
  "board": "news",
  "strategy": "httpx_json",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/json, text/plain, */*",
    "Accept-Language": "en-US,en;q=0.9",
    "Origin": "https://wynncraft.com",
    "Referer": "https://wynncraft.com/news"
  },
  "timeout": 20,
  "list": {
    "url_template": "https://api.wynncraft.com/v3/publisher/articles/list/article",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "page_size_max": 10,
    "list_path": [
      "results"
    ],
    "list_values": true,
    "fields": {
      "post_id": [
        {
          "from": "json",
          "path": [
            "pk"
          ],
          "transform": [
            [
              "to_str"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "json",
          "path": [
            "title"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "json",
          "path": [
            "type"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "template",
          "value": "https://wynncraft.com/news/{category}/{post_id}"
        }
      ],
      "published_at": [
        {
          "from": "json",
          "path": [
            "published_at"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "json",
          "path": [
            "recap"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "json",
          "path": [
            "banner"
          ],
          "transform": [
            [
              "urljoin",
              "https://cdn.wynncraft.com/nextgen/"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://api.wynncraft.com/v3/publisher/articles/fetch/article/{post_id}",
    "fetch_kind": "json",
    "content": [
      {
        "from": "json",
        "path": [
          "content",
          0,
          "content"
        ]
      },
      {
        "from": "json",
        "path": [
          "recap"
        ]
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "json",
          "path": [
            "title"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "json",
          "path": [
            "published_at"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "json",
          "path": [
            "recap"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    },
    "body_empty_acceptable": true
  },
  "_source_url": "https://wynncraft.com/news/",
  "_note": "The Nuxt news page loads a public API. API results are keyed by display rank, so list.list_values=true converts the results object to rows."
}
