{
  "version": 1,
  "site": "www.bundesbank.de",
  "board": "press",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xml,text/xml;q=0.9,text/html;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://www.bundesbank.de/en/press"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 10,
    "max": 12
  },
  "list": {
    "url_template": "https://www.bundesbank.de/service/rss/en/633306/feed.rss",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "-(\\d+)$"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "-(\\d+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %Z",
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "template",
          "value": "press"
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.bundesbank.de/en/press",
  "_note": "handcrafted: submitted /en/press is a press landing page. The automatic HTML attempts followed navigation links under /en/bundesbank/organisation/executive-board; the page exposes an official Latest RSS feed that provides stable press item title/link/guid/pubDate fields. Article bodies are optional because many feed entries are PDF-only or sparse press release pages."
}
