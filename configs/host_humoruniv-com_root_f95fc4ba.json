{
  "version": 1,
  "site": "web.humoruniv.com",
  "board": "humor-pds",
  "strategy": "httpx_html",
  "encoding": "euc-kr",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "list": {
    "url_template": "https://web.humoruniv.com/board/humor/list.html?table=pds",
    "pagination": {"kind": "none"},
    "row_selector": "td.li_sbj",
    "include_notices": true,
    "fields": {
      "post_id": [
        {"from": "attr", "selector": "a", "attr": "href",
         "transform": [["regex_extract", "number=(\\d+)"]]}
      ],
      "title": [
        {"from": "css", "selector": "a", "text": true, "transform": [["collapse_ws"]]}
      ],
      "url": [
        {"from": "attr", "selector": "a", "attr": "href",
         "transform": [["urljoin", "https://web.humoruniv.com/board/humor/"]]}
      ]
    }
  },
  "article": {"fetch_kind": "html", "content": [], "body_empty_acceptable": true},
  "_source_url": "https://www.humoruniv.com/",
  "_note": "웃대 유머자료실(pds) 게시판 — root www.humoruniv.com 은 포털 홈페이지(위젯 혼합)라 board 행 없음. probe first_article(table=pds)가 가리키는 실제 list 는 web.humoruniv.com 서브도메인의 list.html?table=pds. euc-kr. row=td.li_sbj, post_id=number."
}
