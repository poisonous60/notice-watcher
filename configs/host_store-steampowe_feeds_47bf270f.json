{
  "version": 1,
  "site": "store.steampowered.com",
  "board": "app/570",
  "strategy": "httpx_html",
  "headers": {
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR",
    "Upgrade-Insecure-Requests": "1",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Sec-CH-UA": "\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\"",
    "Sec-CH-UA-Mobile": "?0",
    "Sec-CH-UA-Platform": "\"Windows\""
  },
  "timeout": 15,
  "list": {
    "url_template": "https://store.steampowered.com/feeds/news/app/570/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/view/(\\d+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "strip"
            ],
            [
              "html_unescape"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://store.steampowered.com/news/app/570/view/{post_id}",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.news_post_body",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.news_content",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.news_postbody",
        "html": true
      },
      {
        "from": "css",
        "selector": "body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "meta[property='article:published_time']",
          "attr": "content",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ]
    }
  }
}
