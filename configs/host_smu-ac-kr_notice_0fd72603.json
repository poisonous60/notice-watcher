{
  "version": 1,
  "site": "www.smu.ac.kr",
  "board": "notice",
  "strategy": "playwright_html",
  "headless": true,
  "nav_timeout_ms": 30000,
  "idle_timeout_ms": 8000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9",
    "Referer": "https://www.smu.ac.kr/"
  },
  "list": {
    "url_template": "https://www.smu.ac.kr/kor/life/notice.do",
    "pagination": {"kind": "none"},
    "wait_selector": "dl.board-thumb-content-wrap a[href*='articleNo='][href*='mode=view']",
    "row_selector": "dl.board-thumb-content-wrap",
    "row_required_selector": "a[href*='articleNo='][href*='mode=view']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {"from": "attr", "selector": "a[href*='articleNo='][href*='mode=view']", "attr": "href", "transform": [["regex_extract", "articleNo=(\\d+)"]]}
      ],
      "title": [
        {"from": "css", "selector": "dt td:nth-of-type(3) a[href*='articleNo=']", "text": true, "transform": [["collapse_ws"]]}
      ],
      "url": [
        {"from": "attr", "selector": "a[href*='articleNo='][href*='mode=view']", "attr": "href", "transform": [["urljoin", "https://www.smu.ac.kr/kor/life/notice.do"]]}
      ],
      "category": [
        {"from": "css", "selector": "dt td:nth-of-type(2) a[href*='articleNo=']", "text": true, "transform": [["collapse_ws"]]}
      ],
      "author": [
        {"from": "css", "selector": "li.board-thumb-content-writer", "text": true, "transform": [["replace", "작성자", ""], ["collapse_ws"]]}
      ],
      "published_at": [
        {"from": "css", "selector": "li.board-thumb-content-date", "text": true, "transform": [["regex_extract", "(\\d{4}-\\d{2}-\\d{2})"], ["date_only_to_iso", "+09:00"]]}
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {"from": "css", "selector": "div.board-view-content-wrap, div.board-view-content, div.view-con, div.fr-view", "html": true}
    ]
  },
  "_source_url": "https://www.smu.ac.kr/notice",
  "_note": "Catalog /notice returned 404. The official representative notice board is /kor/life/notice.do."
}
