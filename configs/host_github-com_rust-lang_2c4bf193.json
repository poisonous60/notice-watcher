{
  "version": 1,
  "site": "github.com",
  "board": "rust-lang/rust",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9",
    "Referer": "https://github.com/rust-lang/rust/releases",
    "Upgrade-Insecure-Requests": "1"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 1.5
  },
  "list": {
    "url_template": "https://github.com/{board}/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "main#js-repo-pjax-container section",
    "row_required_selector": "a[href*='/releases/tag/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href*='/releases/tag/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)"
            ],
            [
              "strip"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href*='/releases/tag/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href*='/releases/tag/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z",
                "%Y-%m-%dT%H:%M:%S.%f%z"
              ]
            ]
          ]
        },
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "a[data-hovercard-type='user']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "div.markdown-body.tmp-my-3",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body.tmp-my-3",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.Box-body div.markdown-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1 .markdown-title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z",
                "%Y-%m-%dT%H:%M:%S.%f%z"
              ]
            ]
          ]
        },
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ]
            ]
          ]
        }
      ]
    }
  }
}
