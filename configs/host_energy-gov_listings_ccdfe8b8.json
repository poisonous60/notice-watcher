{
  "version": 1,
  "site": "energy.gov",
  "board": "energy-news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xhtml+xml,application/xml;q=0.9,text/html;q=0.8,*/*;q=0.7",
    "Referer": "https://www.energy.gov/listings/energy-news"
  },
  "timeout": 20,
  "list": {
    "url_template": "https://www.energy.gov/rss/energygov/2193718",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "https?://[^/]+/(.+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main article",
        "html": true
      },
      {
        "from": "css",
        "selector": "article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "_source_url": "https://www.energy.gov/listings/energy-news",
  "_note": "Energy News exposes an RSS link at /rss/energygov/2193718. The listing page can be noisy and the failed run timed out in Playwright, so this config polls the RSS feed and fetches article body HTML from the canonical item links."
}
