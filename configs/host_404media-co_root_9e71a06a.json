{
  "version": 1,
  "site": "www.404media.co",
  "board": "root",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://www.404media.co/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.404media.co/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.row.posts > div.col-xs-12.col-md-6.col-lg-4.post-wrap",
    "row_required_selector": "a.post-card__image[href]",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a.post-card__image",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/([^/]+)/?$"
            ],
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h4.post-card__title a",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.post-card__image",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.404media.co"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time.byline__date",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%d"
              ],
              "+09:00"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": ".byline__author a span",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "a.post-card__tag",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "div.post-card__excerpt",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "a.post-card__image img",
          "attr": "data-src",
          "transform": [
            [
              "urljoin",
              "https://www.404media.co"
            ]
          ]
        },
        {
          "from": "attr",
          "selector": "a.post-card__image img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://www.404media.co"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.post-sneak-peek",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.post-hero__title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time.byline__date",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%d"
              ],
              "+09:00"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": ".post-hero__header .byline__author a span",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": ".post-hero__tag",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": ".post-hero__excerpt",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
