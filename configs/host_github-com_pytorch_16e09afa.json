{
  "version": 1,
  "site": "github.com/pytorch",
  "board": "pytorch",
  "strategy": "httpx_html",
  "headers": {
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://github.com/pytorch/pytorch/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 2
  },
  "list": {
    "url_template": "https://github.com/pytorch/pytorch/releases",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main#js-repo-pjax-container section",
    "row_required_selector": "h2.sr-only",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)"
            ],
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ],
              "Z"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "a[data-hovercard-type='user']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "a.Label--success, span.Label--success",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "div.markdown-body.tmp-my-3 > p",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body.tmp-my-3",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.f1.text-normal.markdown-title, h2 .markdown-title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ],
              "Z"
            ]
          ]
        }
      ]
    }
  }
}
