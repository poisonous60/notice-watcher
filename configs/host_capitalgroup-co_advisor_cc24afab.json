{
  "version": 1,
  "site": "www.capitalgroup.com",
  "board": "insights",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept-Language": "en-US,en;q=0.9"
  },
  "timeout": 20,
  "nav_timeout_ms": 45000,
  "idle_timeout_ms": 5000,
  "quiet_ms": 800,
  "list": {
    "url_template": "https://www.capitalgroup.com/advisor/insights.html",
    "pagination": {
      "kind": "none"
    },
    "row_selector": ".cmp-text h3 a[href*='/advisor/insights/articles/'], .gds-card-base__wrapper[data-href*='/advisor/insights/articles/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/advisor/insights/articles/([^/?#]+)\\.html"
            ]
          ]
        },
        {
          "from": "attr",
          "selector": ":self",
          "attr": "data-href",
          "transform": [
            [
              "regex_extract",
              "/advisor/insights/articles/([^/?#]+)\\.html"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ".gds-base__headline",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.capitalgroup.com"
            ]
          ]
        },
        {
          "from": "attr",
          "selector": ":self",
          "attr": "data-href",
          "transform": [
            [
              "urljoin",
              "https://www.capitalgroup.com"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": ".gds-base__description",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.capitalgroup.com/advisor/insights.html",
  "_note": "Capital Group advisor insights page exposes current article links only after the browser/Akamai flow. Use playwright_html on the original insights page; keep list-only because individual article pages redirect unauthenticated direct fetches through the advisor authentication gate."
}
