{
  "version": 1,
  "site": "store.steampowered.com",
  "board": "1086940",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/xhtml+xml,application/xml;q=0.9,text/html;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Upgrade-Insecure-Requests": "1",
    "sec-ch-ua": "\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\"",
    "sec-ch-ua-mobile": "?0",
    "sec-ch-ua-platform": "\"Windows\""
  },
  "timeout": 15,
  "list": {
    "url_template": "https://store.steampowered.com/feeds/news/app/{board}/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/view/(\\d+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubdate",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://store.steampowered.com/news/app/{board}/view/{post_id}",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.news_content",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.news_postbody",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.bb_content",
        "html": true
      }
    ],
    "body_empty_acceptable": true
  }
}
