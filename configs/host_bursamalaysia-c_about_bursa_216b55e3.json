{
  "version": 1,
  "site": "www.bursamalaysia.com",
  "board": "media_releases",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9,ko;q=0.8",
    "Referer": "https://www.bursamalaysia.com/about_bursa/media_centre"
  },
  "timeout": 15,
  "nav_timeout_ms": 20000,
  "idle_timeout_ms": 3000,
  "polite_sleep": {
    "min": 10,
    "max": 12
  },
  "list": {
    "url_template": "https://www.bursamalaysia.com/about_bursa/media_centre",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.cardTable-wrap table.media-releases-table.stacktable.small-only",
    "row_required_selector": "td.text-left a[href*='/sites/'][href$='.pdf'], td.text-left a[href*='/sites/'][href*='.pdf?']",
    "wait_selector": "table.media-releases-table.stacktable.small-only",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "td.text-left a[href*='/sites/']",
          "attr": "href",
          "transform": [
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "/([^/]+)\\.pdf$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "td.text-left a[href*='/sites/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "td.text-left a[href*='/sites/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.bursamalaysia.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "td.st-val.text-center",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%d %B %Y"
              ],
              "+08:00"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "template",
          "value": "media_releases"
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.bursamalaysia.com/about_bursa/media_centre",
  "_note": "handcrafted: automatic attempts targeted DataTables rows that are not the extractable static row unit. Plain httpx receives a Cloudflare challenge from the dev box, while browser entry succeeds; the page exposes press-release PDFs as paired stacktable rows, so the config treats each stacktable table as one item and intentionally registers PDF links without article body extraction."
}
