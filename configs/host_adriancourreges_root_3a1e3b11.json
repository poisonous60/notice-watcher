{
  "version": 1,
  "site": "adriancourreges.com",
  "board": "feed",
  "strategy": "httpx_html",
  "headers": {
    "Accept": "application/rss+xml, application/atom+xml, application/xml;q=0.9, */*;q=0.8"
  },
  "list": {
    "url_template": "https://adriancourreges.com/atom.xml",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "feed > entry",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "id",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link[href]",
          "attr": "href"
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "updated, published",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z",
                "%Y-%m-%dT%H:%M:%S.%f%z",
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "summary, content",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.entry-content, article, main",
        "html": true
      }
    ],
    "body_empty_acceptable": true
  },
  "_source_url": "https://adriancourreges.com/atom.xml",
  "_note": "F-layer RSS-fallback override: gen_fail after LLM HTML attempts; site_kind=hybrid + validated feed."
}
