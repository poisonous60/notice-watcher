{
  "version": 1,
  "site": "oxide.computer",
  "board": "podcast",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xml,text/xml;q=0.9,*/*;q=0.7",
    "Accept-Language": "en-US,en;q=0.9"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 10,
    "max": 12
  },
  "list": {
    "url_template": "https://feeds.transistor.fm/oxide-and-friends",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            ["collapse_ws"],
            ["strip_query_fragment"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            ["collapse_ws"],
            ["iso8601", ["%a, %d %b %Y %H:%M:%S %z", "%a, %d %b %Y %H:%M:%S %Z"]]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            ["html_unescape"],
            ["collapse_ws"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://oxide.computer/podcast/rss.xml",
  "_note": "handcrafted: submitted URL (oxide.computer/podcast/rss.xml) 는 Transistor HTML SPA — 진짜 RSS = feeds.transistor.fm/oxide-and-friends (그 SPA 의 <link rel=alternate>). audio share host (transistor.fm) — body fetch X."
}
