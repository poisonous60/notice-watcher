{
  "version": 1,
  "site": "github.com",
  "board": "anthropics/claude-code",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://github.com/anthropics/claude-code/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 1
  },
  "list": {
    "url_template": "https://github.com/{board}/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "section",
    "row_required_selector": "h2.sr-only, .markdown-body[data-test-selector='body-content']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "h2.sr-only",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "div.Box-body a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "h2.sr-only",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "div.Box-body a.Link--primary.Link",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        },
        {
          "from": "template",
          "value": "https://github.com/{board}/releases/tag/{post_id}"
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "div.Box-body a[href^='/users/'], div.Box-body a[href^='/ashwin-ant']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "div.Box-body img[alt^='@']",
          "attr": "alt",
          "transform": [
            [
              "replace",
              "@",
              ""
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "div.markdown-body[data-test-selector='body-content']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body[data-test-selector='body-content']",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.markdown-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "div.Box-body a.Link--primary.Link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%SZ"
              ]
            ]
          ]
        }
      ]
    }
  }
}
