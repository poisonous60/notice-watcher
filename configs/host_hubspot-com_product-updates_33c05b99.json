{
  "version": 1,
  "site": "community.hubspot.com",
  "board": "releases-updates",
  "strategy": "httpx_json",
  "_slug_board": "product-updates",
  "_source_url": "https://www.hubspot.com/product-updates",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
    "Accept": "application/json, text/javascript, */*; q=0.01",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://community.hubspot.com/t5/Resources/ct-p/resources",
    "X-Requested-With": "XMLHttpRequest"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 5,
    "max": 7
  },
  "list": {
    "url_template": "https://community.hubspot.com/plugins/custom/hubspot/hubspot/resources?posts_per_page=30&node_id={board}&order_by=last_updated&labels=&page={page}&catId=resources&node_type=board",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "page_size_max": 30,
    "success_when": {
      "path": [
        "messages"
      ]
    },
    "list_path": [
      "messages"
    ],
    "fields": {
      "post_id": [
        {
          "from": "json",
          "path": [
            "id"
          ],
          "transform": [
            [
              "to_str"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "json",
          "path": [
            "post_title"
          ],
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "json",
          "path": [
            "post_href"
          ],
          "transform": [
            [
              "urljoin",
              "https://community.hubspot.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "json",
          "path": [
            "last_updated"
          ],
          "transform": [
            [
              "iso8601",
              [
                "%b %d, %Y"
              ],
              "Z"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "json",
          "path": [
            "author_username"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "json",
          "path": [
            "resource_board"
          ],
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "json",
          "path": [
            "post_teaser"
          ],
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "json",
          "path": [
            "cover_image"
          ],
          "transform": [
            [
              "urljoin",
              "https://community.hubspot.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://community.hubspot.com/api/2.0/messages/{post_id}?fields=body,subject,view_href,post_time",
    "fetch_kind": "json",
    "success_when": {
      "path": [
        "status"
      ],
      "equals": "success"
    },
    "data_path": [
      "data"
    ],
    "content": [
      {
        "from": "json",
        "path": [
          "body"
        ]
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "json",
          "path": [
            "subject"
          ],
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "_note": "HubSpot product-updates redirects to the Khoros Resources page. The visible Releases and Updates tab loads via /plugins/custom/hubspot/hubspot/resources with node_id=releases-updates&node_type=board; article bodies are available from the public Khoros api/2.0/messages/{id} endpoint."
}
