{
  "version": 1,
  "site": "www.acm.org",
  "board": "code-of-ethics",
  "strategy": "playwright_html",
  "headers": {
    "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
    "accept-language": "ko-KR",
    "upgrade-insecure-requests": "1",
    "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "sec-ch-ua": "\"HeadlessChrome\";v=\"147\", \"Not.A/Brand\";v=\"8\", \"Chromium\";v=\"147\"",
    "sec-ch-ua-mobile": "?0",
    "sec-ch-ua-platform": "\"Windows\""
  },
  "timeout": 15,
  "list": {
    "url_template": "https://www.acm.org/code-of-ethics",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.article#maincontent article div.zone-2 div.articles > div.landing",
    "row_required_selector": "h1",
    "fields": {
      "post_id": [
        {
          "from": "const",
          "value": "code-of-ethics"
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "const",
          "value": "https://www.acm.org/code-of-ethics"
        }
      ]
    }
  },
  "article": {
    "url_template": "https://www.acm.org/code-of-ethics",
    "fetch_kind": "html",
    "wait_selector": "div.article#maincontent article div.zone-2 div.articles > div.landing h1",
    "content": [
      {
        "from": "css",
        "selector": "div.article#maincontent article div.zone-2 div.articles > div.landing > div.clearfix",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.article#maincontent article div.zone-2 div.articles > div.landing",
        "html": true
      }
    ]
  }
}
