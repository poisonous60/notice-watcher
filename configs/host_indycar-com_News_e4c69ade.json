{
  "version": 1,
  "site": "www.indycar.com",
  "board": "News",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "ko-KR"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://www.indycar.com/News",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "ul.video-news-home-featured-top-stories-list > li.video-news-home-featured-top-stories-list-item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "a[href*='/news/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/news/\\d{4}/\\d{2}/([0-9a-z-]+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href*='/news/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "a[href*='/news/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.indycar.com"
            ]
          ]
        }
      ]
    },
    "include_notices": true
  },
  "article": {
    "url_template": "https://www.indycar.com/news/2026/05/{post_id}",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.article-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
