{
  "version": 1,
  "site": "afkjourney.farlightgames.com",
  "board": "news",
  "strategy": "playwright_html",
  "timeout": 30,
  "nav_timeout_ms": 30000,
  "idle_timeout_ms": 5000,
  "polite_sleep": {"min": 5, "max": 6},
  "route_rewrite_response_headers": [
    {
      "url_pattern": "https://dapcdn.63cj.com/**/*.js",
      "headers": {"content-type": "application/javascript"},
      "fallback_body_when_html": "window['metric-utils']={reportH5SlsMsg:function(){}};"
    }
  ],
  "_source_url": "https://afkjourney.farlightgames.com/news/",
  "_note": "AFK Journey news is a Vue-rendered list backed by inline news_list JSON. Chrome blocks dapcdn.63cj.com/common-utils/*.umd.js with ORB because the CDN serves .js as text/html; route_rewrite_response_headers fixes the response Content-Type so hydration can populate a.news_item rows.",
  "list": {
    "url_template": "https://afkjourney.farlightgames.com/news/",
    "pagination": {"kind": "none"},
    "wait_selector": "a.news_item[href]",
    "row_selector": "div.news_list > a.news_item",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [["regex_extract", "/news/([0-9a-f]{32})/"]]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ".title_box",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [["urljoin", "https://afkjourney.farlightgames.com/"]]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ".date",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {"from": "css", "selector": "div.news_content", "html": true}
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": ".title_box, h1",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  }
}
