{
  "version": 1,
  "site": "www.bethesda.net",
  "board": "news",
  "strategy": "playwright_html",
  "disable_stealth": true,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7",
    "Referer": "https://www.bethesda.net/ko/news/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.bethesda.net/ko/news?limit=10&order=desc&tags=news",
    "pagination": {
      "kind": "offset",
      "offset_param": "skip",
      "page_unit": 10,
      "extra_params_when_paged": {
        "limit": "10",
        "order": "desc",
        "tags": "news"
      }
    },
    "row_selector": "a[href*='/ko/article/']",
    "wait_selector": "a[href*='/ko/article/']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/ko/article/([^/]+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.bethesda.net"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main#_bnContent",
        "html": true
      },
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
