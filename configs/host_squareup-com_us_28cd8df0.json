{
  "version": 1,
  "site": "squareup.com",
  "board": "us/en/press",
  "strategy": "httpx_html",
  "_source_url": "https://squareup.com/us/en/press",
  "_note": "handcrafted: Square press page exposes static press-release cards; probe already identified the stable card selector.",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9"
  },
  "timeout": 20,
  "list": {
    "url_template": "https://squareup.com/{board}",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.press-newsroom.latest-press-releases > div.press-release-preview",
    "row_required_selector": "a[href^='/us/en/press/'] h3",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href^='/us/en/press/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "^/us/en/press/([^/?#]+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href^='/us/en/press/'] h3",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href^='/us/en/press/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://squareup.com"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ".font-eyebrow-small.color-gray",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%B %d, %Y"
              ],
              "Z"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "attr",
          "attr": "data-categories",
          "transform": [
            [
              "replace",
              "filter-",
              ""
            ],
            [
              "replace",
              ",",
              ", "
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "source[data-srcset]",
          "attr": "data-srcset",
          "transform": [
            [
              "regex_extract",
              "^([^,\\s]+)"
            ],
            [
              "urljoin",
              "https://squareup.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main div.content",
        "html": true
      },
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ".font-eyebrow-large.color-gray",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%B %d, %Y"
              ],
              "Z"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": ".category-holder a",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
