{
  "version": 1,
  "site": "uio.no",
  "board": "english-news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/atom+xml,application/xml,text/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://www.uio.no/english/about/news-and-events/news/"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.uio.no/english/about/news-and-events/news/?vrtx=feed",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "entry",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "link[rel='alternate']",
          "attr": "href",
          "transform": [
            ["strip_query_fragment"],
            ["regex_extract", "/news/(\\d{4}/[^.]+)\\.html$"]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "link[rel='alternate']",
          "attr": "href",
          "transform": [
            ["urljoin", "https://www.uio.no"],
            ["strip_query_fragment"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "published",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "summary",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "_source_url": "https://www.uio.no/english/about/news-and-events/news/",
  "_note": "handcrafted source remap: submitted UiO news page advertises an official Atom feed via link rel=alternate ?vrtx=feed. Use that feed for unique stable entries and fetch full article body from the linked HTML pages."
}
