{
  "version": 1,
  "site": "skullgirls.com",
  "board": "news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://skullgirls.com/news/"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://skullgirls.com/news/",
    "pagination": {
      "kind": "path_segment",
      "page_param": "page"
    },
    "row_selector": "div.content > article.post-excerpt",
    "row_required_selector": "h2 a",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "h2 a",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/((?:\\d{4}/\\d{2}/[^/?#]+))/?$"
            ],
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h2 a",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "h2 a",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://skullgirls.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time.dt-published",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z",
                "%Y-%m-%dT%H:%M:%S.%f%z"
              ]
            ]
          ]
        },
        {
          "from": "css",
          "selector": "time.dt-published",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%b %d, %Y"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "span.p-author",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "article.post-excerpt > p",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.post-content.e-content",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h2[itemprop='name headline']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time.dt-published",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z",
                "%Y-%m-%dT%H:%M:%S.%f%z"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "span.p-author",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
