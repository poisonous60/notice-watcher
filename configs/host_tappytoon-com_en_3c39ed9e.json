{
  "version": 1,
  "site": "support.tappytoon.com",
  "board": "news_notices",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "notice-watcher/1.0 (+polite)"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://support.tappytoon.com/en/support/solutions/folders/47000726735",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "a[href*='/en/support/solutions/articles/'].row",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/articles/(\\d+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ".line-clamp-2",
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://support.tappytoon.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "content": [
      {
        "from": "css",
        "selector": ".fw-content--single-article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "_source_url": "https://www.tappytoon.com/en/notice",
  "_remapped_from": "https://www.tappytoon.com/en/notice",
  "_note": "Original /en/notice returns 404. The live Tappytoon Notice menu redirects /en/notices to Freshdesk category 47000495287, whose Notices & News folder 47000726735 contains the article list."
}
