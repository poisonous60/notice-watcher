{
  "version": 1,
  "site": "https://www.djangoproject.com/weblog/",
  "board": "host_djangoproject-c_weblog_6521cddb",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "ko-KR",
    "Upgrade-Insecure-Requests": "1"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://www.djangoproject.com/rss/weblog/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/([^/?#]+)/?$"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "/([^/?#]+)/?$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main#main-content .blog-entry-body",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.blog-entry-body",
        "html": true
      }
    ]
  }
}
