{
  "version": 1,
  "site": "www.plaync.com",
  "board": "notice",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7"
  },
  "timeout": 20,
  "nav_timeout_ms": 30000,
  "idle_timeout_ms": 12000,
  "list": {
    "url_template": "https://www.plaync.com/ko-kr/board/notice/list",
    "pagination": {
      "kind": "none"
    },
    "page_size_max": 20,
    "wait_selector": "div.board a.title[href*='/ko-kr/board/notice/view?articleId=']",
    "row_selector": "div.board",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "a.title",
          "attr": "href",
          "transform": [
            ["regex_extract", "[?&]articleId=([^&#]+)"]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.title",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "a.title",
          "attr": "href",
          "transform": [
            ["urljoin", "https://www.plaync.com"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "span.posted-at",
          "text": true,
          "match": "^\\d{4}-\\d{2}-\\d{2}$",
          "transform": [
            ["date_only_to_iso", "+09:00"]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "a.summary",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "wait_selector": "div.view-body",
    "content": [
      {
        "from": "css",
        "selector": "div.view-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h2.view-title",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "span.posted-at",
          "text": true,
          "match": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "transform": [
            ["iso8601", ["%Y-%m-%d %H:%M:%S"], "+09:00"]
          ]
        }
      ]
    }
  },
  "_source_url": "https://www.plaync.com/ko-kr/board/notice/list",
  "_note": "track-A config: PlayNC notice list is rendered client-side and exposes stable /ko-kr/board/notice/view?articleId=... detail links. Track-B fixed generic view-link cluster classification so this CMS pattern is no longer mistaken for a nav/section hub."
}
