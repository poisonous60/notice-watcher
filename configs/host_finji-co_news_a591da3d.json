{
  "version": 1,
  "site": "finji.co",
  "board": "news",
  "strategy": "httpx_html",
  "_slug_board": "news",
  "_source_url": "https://www.finji.co/news/",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://finji.co/news/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://finji.co/feed.xml",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "channel > item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "regex_extract",
              "<h[12][^>]*>([^<]+)</h[12]>"
            ],
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "https?://[^/]+/news/([0-9]{4}/[0-9]{2}/[0-9]{2}/[^?#]+)$"
            ],
            [
              "replace",
              ".html",
              ""
            ],
            [
              "replace",
              "/",
              " "
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "strip"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %z"
              ]
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "html_unescape"
            ],
            [
              "regex_extract",
              "<img[^>]+src=[\"']([^\"']+)"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.post-content",
        "html": true
      },
      {
        "from": "css",
        "selector": "article.post",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.post-title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "img.post-hero-img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://finji.co"
            ]
          ]
        }
      ]
    }
  },
  "_note": "Finji news page exposes a validated RSS feed at /feed.xml. The HTML /news page also contains product links, so polling the RSS feed avoids selecting /games cards as news posts."
}
