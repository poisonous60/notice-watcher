{
  "version": 1,
  "site": "community.cloudflare.com",
  "board": "latest",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept-Language": "ko-KR,ko;q=0.9",
    "Referer": "https://community.cloudflare.com/"
  },
  "nav_timeout_ms": 25000,
  "idle_timeout_ms": 6000,
  "quiet_ms": 1000,
  "polite_sleep": {
    "min": 5,
    "max": 7
  },
  "list": {
    "url_template": "https://community.cloudflare.com/latest",
    "pagination": {
      "kind": "none"
    },
    "wait_selector": "tr.topic-list-item",
    "row_selector": "tr.topic-list-item",
    "row_required_selector": "a.title.raw-topic-link",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": ":self",
          "attr": "data-topic-id"
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.title.raw-topic-link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.title.raw-topic-link",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://community.cloudflare.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "attr",
          "selector": "span.relative-date[data-time]",
          "attr": "data-time",
          "transform": [
            [
              "regex_extract",
              "^(\\d{10})"
            ],
            [
              "unixtime_to_iso"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": ".badge-category__name",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "a.topic-excerpt span[dir=\"auto\"]",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://community.cloudflare.com/latest",
    "content": [
      {
        "from": "css",
        "selector": "main.__notice_watcher_body_unavailable__",
        "html": true
      }
    ],
    "body_empty_acceptable": true
  },
  "_source_url": "https://community.cloudflare.com/",
  "_note": "Cloudflare Community is Discourse, but /latest.json and /t/{id}.json return Cloudflare challenge 403 from this environment. Use Playwright-rendered /latest for post detection; article body is accepted empty because direct topic fetch is challenge-gated."
}
