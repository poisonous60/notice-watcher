{
  "version": 1,
  "site": "grafana.com",
  "board": "blog",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9"
  },
  "timeout": 15,
  "_source_url": "https://grafana.com/blog/",
  "_note": "handcrafted: static blog list rows are ul.space-y-10 > li; nav rows caused the generated config to extract 0 posts",
  "list": {
    "url_template": "https://grafana.com/blog/",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "article:has(a[href^='/blog/']):not(:has(a[href='/blog/']))",
    "row_required_selector": "a[href^='/blog/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href^='/blog/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "^/blog/(?!$)",
          "transform": [
            [
              "regex_extract",
              "^/blog/([^/?#]+)/?"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href^='/blog/']",
          "pick": "first_matching",
          "match": "\\S",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href^='/blog/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "^/blog/(?!$)",
          "transform": [
            [
              "urljoin",
              "https://grafana.com"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "a[href^='/tags/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.rich-text",
        "html": true
      },
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
