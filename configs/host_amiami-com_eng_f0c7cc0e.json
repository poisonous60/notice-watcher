{
  "version": 1,
  "site": "www.amiami.com",
  "board": "news",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9,ko;q=0.8",
    "Referer": "https://www.amiami.com/eng/news/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.amiami.com/eng/news/",
    "pagination": {
      "kind": "none"
    },
    "wait_selector": "div.wrapper > div.topics-list > dl.topics-list__list-item",
    "row_selector": "div.wrapper > div.topics-list > dl.topics-list__list-item",
    "fields": {
      "post_id": [
        {
          "from": "concat",
          "parts": [
            {
              "from": "css",
              "selector": "dt.topics-list__text > span.topics-list__text__date",
              "text": true,
              "transform": [
                ["collapse_ws"],
                ["replace", ",", ""],
                ["replace", " ", "-"]
              ]
            },
            {
              "const": "-"
            },
            {
              "from": "css",
              "selector": "dd.topics-list__accordion > span.topics-list__text__title",
              "text": true,
              "transform": [
                ["collapse_ws"],
                ["regex_extract", "^(.{1,80})"],
                ["replace", " ", "-"],
                ["replace", ",", ""],
                ["replace", "(", ""],
                ["replace", ")", ""],
                ["replace", "&", "and"],
                ["replace", ";", ""],
                ["replace", "'", ""],
                ["replace", "\"", ""],
                ["replace", "\u2014", "-"],
                ["replace", "\u2013", "-"],
                ["replace", "\u2011", "-"]
              ]
            }
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "dd.topics-list__accordion > span.topics-list__text__title",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "url": [
        {
          "from": "const",
          "value": "https://www.amiami.com/eng/news/"
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "dt.topics-list__text > span.topics-list__text__date",
          "text": true,
          "transform": [
            ["collapse_ws"],
            ["iso8601", ["%b %d, %Y"], "+09:00"]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "dd.topics-list__inner > span.topics-list__inner__list-item",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.amiami.com/eng/news/",
  "_note": "AmiAmi English news is a Playwright-rendered list-only accordion. Rows have no per-entry URL; use date plus sanitized title prefix as the stable post_id and keep the original board URL for each notice."
}
