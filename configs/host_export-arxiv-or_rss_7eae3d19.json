{
  "version": 1,
  "site": "export.arxiv.org",
  "board": "cs",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xml,text/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://export.arxiv.org/rss/cs"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://export.arxiv.org/rss/{board}",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "rss > channel > item",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "guid",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "regex_extract",
              "([^/]+)$"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "regex_extract",
              "([^/]+)$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "link",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "pubDate",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%a, %d %b %Y %H:%M:%S %Z"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "author",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "description",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "body_empty_acceptable": true,
    "content": []
  }
}
