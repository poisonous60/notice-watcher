{
  "version": 1,
  "site": "france24.com",
  "board": "en",
  "strategy": "playwright_html",
  "headers": {
    "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
    "accept-language": "ko-KR",
    "upgrade-insecure-requests": "1",
    "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "sec-ch-ua": "\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\"",
    "sec-ch-ua-mobile": "?0",
    "sec-ch-ua-platform": "\"Windows\""
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 5
  },
  "list": {
    "url_template": "https://www.france24.com/{board}/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main [data-article-list]",
    "row_required_selector": "a[data-article-item-link][href^='/en/']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[data-article-item-link][href^='/en/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "^/en/(.+)$"
            ],
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[data-article-item-link] h2",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[data-article-item-link][href^='/en/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.france24.com"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": ".m-master-tag .a-tag-section",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": ".article__chapo",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "a[data-article-item-link] img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://www.france24.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "url_template": "https://www.france24.com/{board}/{post_id}",
    "content": [
      {
        "from": "css",
        "selector": "div.t-content__body",
        "html": true
      },
      {
        "from": "css",
        "selector": "div[data-article-content] .t-content__body",
        "html": true
      },
      {
        "from": "css",
        "selector": "main .t-content__body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.t-content__title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ".m-pub-dates time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "+00:00"
              ]
            ]
          ]
        }
      ]
    }
  }
}
