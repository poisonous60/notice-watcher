{
  "version": 1,
  "site": "apnews.com",
  "board": "root",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/rss+xml,application/xhtml+xml,application/xml;q=0.9,text/html;q=0.8,*/*;q=0.7",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://apnews.com/"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://apnews.com/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.PagePromo:has(a[href*='/article/'])",
    "row_required_selector": "a[href*='/article/']",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "a[href*='/article/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "https://apnews\\.com/article/",
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "/article/([^/?#]+)"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "a[href*='/article/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "https://apnews\\.com/article/",
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "/article/([^/?#]+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href*='/article/']",
          "pick": "first_matching",
          "match": "\\S",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "a[href*='/article/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "https://apnews\\.com/article/",
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "a[href^='/hub/'], a[href^='/category/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.RichTextStoryBody",
        "html": true
      },
      {
        "from": "css",
        "selector": ".RichTextStoryBody",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.Page-content",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "meta[property='article:published_time']",
          "attr": "content",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "span.Page-authors a, a[rel='author']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "_source_url": "https://apnews.com/",
  "_note": "handcrafted: root rows contain duplicate/empty links; use PagePromo article rows with first non-empty article link text and RichTextStoryBody for article content."
}
