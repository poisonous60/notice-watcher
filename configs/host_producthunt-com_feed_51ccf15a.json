{
  "version": 1,
  "site": "producthunt.com",
  "board": "feed",
  "strategy": "httpx_html",
  "list": {
    "url_template": "https://www.producthunt.com/feed",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "entry",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "id",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "Post/(\\d+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "link[rel=\"alternate\"]",
          "attr": "href",
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "strip"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "published",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "author > name",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "content",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "skip_status": [
      403
    ],
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.producthunt.com/feed",
  "_note": "Product Hunt /feed is Atom. Use feed entries directly; product pages are not needed for baseline notification text."
}
