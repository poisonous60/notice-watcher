{
  "version": 1,
  "site": "imf.org",
  "board": "news",
  "strategy": "playwright_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
    "Accept-Language": "ko-KR",
    "Upgrade-Insecure-Requests": "1",
    "Sec-CH-UA": "\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\"",
    "Sec-CH-UA-Mobile": "?0",
    "Sec-CH-UA-Platform": "\"Windows\""
  },
  "timeout": 20,
  "nav_timeout_ms": 45000,
  "idle_timeout_ms": 10000,
  "quiet_ms": 1000,
  "polite_sleep": {"min": 5, "max": 8},
  "list": {
    "url_template": "https://www.imf.org/en/news",
    "pagination": {"kind": "none"},
    "wait_selector": "div.link-list--news li",
    "row_selector": "div.link-list--news li",
    "row_required_selector": "a[href*='/en/news/articles/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a",
          "attr": "href",
          "transform": [["regex_extract", "^/en/news/articles/\\d{4}/\\d{2}/\\d{2}/([^?#/]+)"]]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a",
          "text": true,
          "transform": [["collapse_ws"], ["regex_extract", "^\\w+ \\d{1,2}, \\d{4}\\s+(.+)$"]]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a",
          "attr": "href",
          "transform": [["urljoin", "https://www.imf.org"]]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "span",
          "text": true,
          "transform": [["collapse_ws"], ["iso8601", ["%B %d, %Y"], "+00:00"]]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "wait_selector": "article section > div:nth-of-type(3)",
    "content": [
      {"from": "css", "selector": "article section > div:nth-of-type(2)", "html": true},
      {"from": "css", "selector": "article section > div:not([id]):not(.imf-com)", "html": true},
      {"from": "css", "selector": "article div.column-padding", "html": true},
      {"from": "css", "selector": "article", "html": true}
    ],
    "enrich": {
      "title": [
        {"from": "css", "selector": "article h2.pr", "text": true, "transform": [["collapse_ws"]]}
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "article p.date",
          "text": true,
          "transform": [["collapse_ws"], ["iso8601", ["%B %d, %Y"], "+00:00"]]
        }
      ]
    }
  },
  "_source_url": "https://www.imf.org/en/News",
  "_note": "Auto generation found the Latest News list but used a non-existent article[aria-label='primary content'] body root. The article body hydrates in Playwright as the second div under article section."
}
