{
  "version": 1,
  "site": "github.com",
  "board": "kubernetes/kubernetes",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR",
    "Referer": "https://github.com/kubernetes/kubernetes/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 1
  },
  "list": {
    "url_template": "https://github.com/kubernetes/kubernetes/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "section",
    "row_required_selector": "a[href^=\"/kubernetes/kubernetes/releases/tag/\"]",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href^=\"/kubernetes/kubernetes/releases/tag/\"]",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)"
            ],
            [
              "strip"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h2.sr-only",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "a[href^=\"/kubernetes/kubernetes/releases/tag/\"]",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href^=\"/kubernetes/kubernetes/releases/tag/\"]",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "a[data-hovercard-type=\"user\"]",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    },
    "fields_order": [
      "post_id",
      "title",
      "url",
      "published_at",
      "author"
    ]
  },
  "article": {
    "url_template": "https://github.com/kubernetes/kubernetes/releases/tag/{post_id}",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.markdown-body.tmp-my-3[data-test-selector=\"body-content\"]",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.markdown-body[data-test-selector=\"body-content\"]",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.markdown-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.sr-only",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "div.f1.text-bold a",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601"
            ]
          ]
        }
      ]
    }
  }
}
