{
  "version": 1,
  "site": "github.com",
  "board": "dkundel-openai",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://github.com/dkundel-openai"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 1,
    "max": 1
  },
  "list": {
    "url_template": "https://github.com/{board}",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "ol.d-flex.flex-wrap.list-style-none.gutter-condensed > li",
    "row_required_selector": "a.min-width-0.Link.text-bold.flex-auto",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a.min-width-0.Link.text-bold.flex-auto",
          "attr": "href",
          "transform": [
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.min-width-0.Link.text-bold.flex-auto .repo",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "a.min-width-0.Link.text-bold.flex-auto",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.min-width-0.Link.text-bold.flex-auto",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://github.com"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "template",
          "value": "{board}"
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "p.pinned-item-desc",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "span[itemprop='programmingLanguage']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://github.com/{post_id}",
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "article.markdown-body.entry-content.container-lg",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.js-snippet-clipboard-copy-unpositioned article.markdown-body.entry-content.container-lg",
        "html": true
      },
      {
        "from": "css",
        "selector": "article.markdown-body",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1.vcard-names span.p-name",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "strong a[href^='/'][data-discover='true']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
