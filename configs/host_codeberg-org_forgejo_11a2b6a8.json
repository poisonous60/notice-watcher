{
  "version": 1,
  "site": "codeberg.org",
  "board": "forgejo/forgejo",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://codeberg.org/forgejo/forgejo/releases"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 2,
    "max": 3
  },
  "list": {
    "url_template": "https://codeberg.org/{board}/releases",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "row_selector": "#release-list > li",
    "row_required_selector": "div.release-title-wrap h4 > a[href*='/releases/tag/']",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "div.release-title-wrap h4 > a[href*='/releases/tag/']",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/releases/tag/([^/?#]+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "div.release-title-wrap h4 > a",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "div.release-title-wrap h4 > a[href*='/releases/tag/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://codeberg.org"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "attr",
          "selector": "span.time relative-time, span.time > relative-time",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S%z"
              ]
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "span.author a.author, a.author",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "span.ui.green.label, span.ui.label",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "div.markup.desc",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://codeberg.org/forgejo/forgejo/releases",
  "_note": "Codeberg Forgejo releases — release list page exposes stable tag links, dates, authors, labels, and summary text. Direct release tag pages return a JavaScript cookie challenge to plain httpx, so this config intentionally registers title/URL/summary only with body_empty_acceptable."
}
