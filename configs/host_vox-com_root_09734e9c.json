{
  "version": 1,
  "site": "vox.com",
  "board": "home",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9"
  },
  "timeout": 15,
  "_source_url": "https://www.vox.com/",
  "_note": "handcrafted: use the static numbered home list to avoid duplicate responsive content-card copies",
  "list": {
    "url_template": "https://www.vox.com/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main ol li",
    "row_required_selector": "a[href]",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href]",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "/(\\d+)/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a[href]",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href]",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.vox.com"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main article",
        "html": true
      },
      {
        "from": "css",
        "selector": "article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "time[datetime]",
          "attr": "datetime",
          "transform": [
            [
              "iso8601",
              [
                "%Y-%m-%dT%H:%M:%S.%fZ",
                "%Y-%m-%dT%H:%M:%SZ",
                "%Y-%m-%d"
              ],
              "+00:00"
            ]
          ]
        }
      ]
    }
  }
}
