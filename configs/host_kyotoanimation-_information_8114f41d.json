{
  "version": 1,
  "site": "www.kyotoanimation.co.jp",
  "board": "information",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ja-JP,ja;q=0.9,ko;q=0.8",
    "Referer": "https://www.kyotoanimation.co.jp/information/"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 5,
    "max": 6
  },
  "list": {
    "url_template": "https://www.kyotoanimation.co.jp/information/",
    "pagination": {
      "kind": "query_param",
      "page_param": "pageID"
    },
    "row_selector": "#mainContentInfo > article.infoDataTop, #mainContentInfo > article.infoData",
    "fields": {
      "post_id": [
        {
          "from": "concat",
          "parts": [
            {
              "from": "attr",
              "selector": "time",
              "attr": "datetime",
              "transform": [
                ["replace", "+", ""]
              ]
            },
            {
              "const": "/"
            },
            {
              "from": "attr",
              "selector": "a.info",
              "attr": "href",
              "transform": [
                ["replace", "+", ""],
                ["replace", "?", "-"],
                ["replace", "&", "-"],
                ["replace", "=", "-"],
                ["replace", "#", "-"]
              ]
            }
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.info",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        },
        {
          "from": "attr",
          "selector": "a.info",
          "attr": "title",
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.info",
          "attr": "href",
          "transform": [
            ["urljoin", "https://www.kyotoanimation.co.jp"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "attr",
          "selector": "time",
          "attr": "datetime",
          "transform": [
            ["iso8601", ["%Y-%m-%dT%H:%M:%S%z"]]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "a.info",
          "attr": "title",
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "img",
          "attr": "src",
          "transform": [
            ["urljoin", "https://www.kyotoanimation.co.jp"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "skip_status": [200],
    "content": [],
    "body_empty_acceptable": true
  },
  "_source_url": "https://www.kyotoanimation.co.jp/information/",
  "_note": "Kyoto Animation information rows are static HTML but many entries link directly to external product sites, and repeated campaign hosts make href-only post_id non-unique. Use a date+href list key and list-only article handling."
}
