    "fields": {
      "post_id": [
        {"from": "attr", "selector": "td.td-lf a", "attr": "href", "transform": [["regex_extract", "[?&]encid=([^&]+)"]]}
      ],
      "title": [
        {"from": "css", "selector": "td.td-lf a", "text": true, "transform": [["collapse_ws"]]}
      ],
      "url": [
        {"from": "attr", "selector": "td.td-lf a", "attr": "href", "transform": [["urljoin", "https://www.bucheon.go.kr/site/program/board/basicboard/list?boardtypeid=26736&menuid=148002001001&pagesize=20"]]}
      ],
      "published_at": [
        {"from": "css", "selector": "td:nth-of-type(4)", "text": true, "transform": [["collapse_ws"], ["date_only_to_iso", "+09:00"]]}
      ],
      "author": [
        {"from": "css", "selector": "td:nth-of-type(3)", "text": true, "transform": [["collapse_ws"]]}
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {"from": "css", "selector": "#contents", "html": true},
      {"from": "css", "selector": "body", "html": true}
    ]
