{
  "version": 1,
  "site": "www.viz.com",
  "board": "blog",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "timeout": 15,
  "polite_sleep": {
    "min": 2,
    "max": 2
  },
  "list": {
    "url_template": "https://www.viz.com/blog",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "#posts_wrapper > article",
    "row_required_selector": "a[href^='/blog/posts/']",
    "fields": {
      "post_id": [
        {
          "from": "css",
          "selector": "a[href^='/blog/posts/']",
          "attr": "href",
          "pick": "first_matching",
          "match": "^/blog/posts/[^/?#]+",
          "transform": [
            [
              "strip_query_fragment"
            ],
            [
              "regex_extract",
              "^/blog/posts/([^/?#]+)"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h4 a[href^='/blog/posts/']",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "css",
          "selector": "h4 a[href^='/blog/posts/']",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://www.viz.com"
            ],
            [
              "strip_query_fragment"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": ".line-caption p",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "#post_row .context-copy",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "#page_title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "#post_row header .mar-t-md",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "regex_extract",
              "([A-Z][a-z]+ \\d{1,2}, \\d{4})"
            ],
            [
              "iso8601",
              [
                "%B %d, %Y"
              ],
              "-07:00"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "#post_row header .mar-t-md span:first-child",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "remove_prefix",
              "By "
            ]
          ]
        }
      ]
    }
  },
  "_source_url": "https://www.viz.com/blog",
  "_note": "handcrafted: S4/headless returned 429 but static H2 HTML has #posts_wrapper rows; article body lives under #post_row .context-copy."
}
