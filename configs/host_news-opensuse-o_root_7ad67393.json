{
  "version": 1,
  "site": "news.opensuse.org",
  "board": "root",
  "strategy": "playwright_html",
  "headers": {
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "ko-KR",
    "Upgrade-Insecure-Requests": "1",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",
    "Sec-CH-UA": "\"Chromium\";v=\"147\", \"Not.A/Brand\";v=\"8\"",
    "Sec-CH-UA-Mobile": "?0",
    "Sec-CH-UA-Platform": "\"Windows\""
  },
  "timeout": 15,
  "list": {
    "url_template": "https://news.opensuse.org/",
    "pagination": {
      "kind": "query_param",
      "page_param": "page"
    },
    "wait_selector": "div.container.my-3 div.col-12.col-lg-9.mx-3.mx-auto div.row > div.col-lg-6.col-12.p-3",
    "row_selector": "div.col-12.col-lg-9.mx-3.mx-auto div.row > div.col-lg-6.col-12.p-3",
    "row_required_selector": "a.text-black.link_unstyled[href]",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a.text-black.link_unstyled[href]",
          "attr": "href",
          "transform": [
            [
              "strip",
              "/"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled h2",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a.text-black.link_unstyled[href]",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://news.opensuse.org"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled .font-weight-bold.text-muted span",
          "pick": "first_matching",
          "match": "^\\d{1,2}\\.\\s+[A-Za-z]{3,9}\\s+\\d{4}$",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%d. %B %Y",
                "%d. %b %Y"
              ],
              "+09:00"
            ]
          ]
        },
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled .font-weight-bold.text-muted span",
          "pick": "first_matching",
          "match": "^\\d{1,2}\\.\\s+[A-Za-z]{3}\\s+\\d{4}$",
          "text": true,
          "transform": [
            [
              "iso8601",
              [
                "%d. %b %Y"
              ],
              "+09:00"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled .font-weight-bold.text-muted span",
          "pick": "first_matching",
          "match": "^(?!\\d{1,2}\\.\\s+[A-Za-z]{3,9}\\s+\\d{4}$).+",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "a.text-black.link_unstyled .text-justify p",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "a.text-black.link_unstyled img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://news.opensuse.org"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "div.container.my-5.article > div.col-md-7.col-12.mx-auto.text-justify",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.container.my-5.article div.col-md-7.col-12.py-3.mx-auto.text-justify",
        "html": true
      },
      {
        "from": "css",
        "selector": "div.container.my-5.article",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "header.article-header h1.decorated-title",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": "header.article-header p.text-center.text-muted",
          "text": true,
          "match": "^\\d{1,2}\\.\\s+[A-Za-z]{3,9}\\s+\\d{4}\\s*\\|",
          "transform": [
            [
              "regex_extract",
              "^(\\d{1,2}\\.\\s+[A-Za-z]{3,9}\\s+\\d{4})"
            ],
            [
              "iso8601",
              [
                "%d. %B %Y",
                "%d. %b %Y"
              ],
              "+09:00"
            ]
          ]
        }
      ],
      "author": [
        {
          "from": "css",
          "selector": "header.article-header p.text-center.text-muted",
          "text": true,
          "match": "\\|",
          "transform": [
            [
              "regex_extract",
              "\\|\\s*([^|]+?)\\s*\\|"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "header.article-header img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://news.opensuse.org"
            ]
          ]
        }
      ]
    }
  }
}
