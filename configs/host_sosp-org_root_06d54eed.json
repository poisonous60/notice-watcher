{
  "version": 1,
  "site": "sosp.org",
  "board": "proceedings",
  "strategy": "httpx_html",
  "_source_url": "https://sosp.org/",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8",
    "Referer": "https://sosp.org/"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://sosp.org/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "font:has(a[href*='sosp.org/'])",
    "row_required_selector": "a[href]",
    "include_notices": true,
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": "a[href]",
          "attr": "href",
          "transform": [
            ["regex_extract", "/(\\d{4})/?$"]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            ["collapse_ws"]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": "a[href]",
          "attr": "href",
          "transform": [
            ["urljoin", "https://sosp.org/"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main",
        "html": true
      },
      {
        "from": "css",
        "selector": "body",
        "html": true
      }
    ],
    "body_empty_acceptable": true
  },
  "_note": "SOSP root is a static proceedings index. The failed generated config selected no rows; the stable rows are the linked proceedings entries whose href year is the post_id."
}
