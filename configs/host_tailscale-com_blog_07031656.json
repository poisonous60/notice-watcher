{
  "version": 1,
  "site": "tailscale.com",
  "board": "blog",
  "strategy": "httpx_html",
  "_source_url": "https://tailscale.com/blog/",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en;q=0.8"
  },
  "timeout": 20,
  "list": {
    "url_template": "https://tailscale.com/{board}/",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "main a[href^='/blog/']",
    "row_required_selector": "h3",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "^/blog/([^/?#]+)/?$"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": "h3",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "urljoin",
              "https://tailscale.com"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "css",
          "selector": "span",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "summary": [
        {
          "from": "css",
          "selector": "p",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "cover_image": [
        {
          "from": "attr",
          "selector": "img",
          "attr": "src",
          "transform": [
            [
              "urljoin",
              "https://tailscale.com"
            ]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ]
  }
}
