{
  "version": 1,
  "site": "nps.or.kr",
  "board": "notice",
  "strategy": "httpx_html",
  "_source_url": "https://www.nps.or.kr/jsppage/main.jsp",
  "_note": "deprecated JSP entry workaround: /jsppage/main.jsp now returns an error, while the official current homepage is /main.do. The homepage exposes recent notice links as static JavaScript hrefs.",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7",
    "Referer": "https://www.nps.or.kr/index.jsp"
  },
  "timeout": 20,
  "encoding": "utf-8",
  "polite_sleep": {
    "min": 5,
    "max": 5
  },
  "list": {
    "url_template": "https://www.nps.or.kr/main.do",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "a[href*='fnc_newsInfoDetail'][href*='BS20240137']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "attr": "href",
          "transform": [
            [
              "regex_extract",
              "fnc_newsInfoDetail\\('([^']+)'"
            ]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ],
            [
              "regex_extract",
              "^(.*?)\\s+\\d{4}-\\d{2}-\\d{2}$"
            ]
          ]
        },
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "collapse_ws"
            ]
          ]
        }
      ],
      "url": [
        {
          "from": "template",
          "value": "https://www.nps.or.kr/pnsgdnc/newgdnc/getOHAE0001M1.do?hmpgBbsCd=BS20240137&hmpgCd=01&menuId=MN24000897&pageIndex=1&pstId={post_id}&searchGbu=&searchText=&sortSe=FR"
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ":self",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "(\\d{4}-\\d{2}-\\d{2})$"
            ],
            [
              "date_only_to_iso",
              "+09:00"
            ]
          ]
        }
      ],
      "category": [
        {
          "from": "template",
          "value": "notice"
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main table",
        "html": true
      },
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "table",
          "text": true,
          "transform": [
            [
              "regex_extract",
              "제목\\s+(.+?)\\s+작성부서"
            ],
            [
              "collapse_ws"
            ]
          ]
        }
      ]
    }
  }
}
