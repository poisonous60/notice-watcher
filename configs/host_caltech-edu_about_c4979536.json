{
  "version": 1,
  "site": "caltech.edu",
  "board": "about-news",
  "strategy": "httpx_html",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://www.caltech.edu/about/news"
  },
  "timeout": 20,
  "polite_sleep": {
    "min": 10,
    "max": 12
  },
  "list": {
    "url_template": "https://www.caltech.edu/about/news",
    "pagination": {
      "kind": "none"
    },
    "row_selector": "div.article-teaser",
    "row_required_selector": ".article-teaser__title a[href*='/about/news/']",
    "fields": {
      "post_id": [
        {
          "from": "attr",
          "selector": ".article-teaser__title a",
          "attr": "href",
          "transform": [
            ["urljoin", "https://www.caltech.edu"],
            ["strip_query_fragment"],
            ["regex_extract", "/about/news/([^/]+)$"]
          ]
        }
      ],
      "title": [
        {
          "from": "css",
          "selector": ".article-teaser__title a",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "attr",
          "selector": ".article-teaser__title a",
          "attr": "href",
          "transform": [
            ["urljoin", "https://www.caltech.edu"],
            ["strip_query_fragment"]
          ]
        }
      ],
      "published_at": [
        {
          "from": "css",
          "selector": ".article-teaser__published-date__date",
          "text": true,
          "transform": [
            ["collapse_ws"],
            ["iso8601", ["%B %d, %Y"], "-08:00"]
          ]
        }
      ]
    }
  },
  "article": {
    "fetch_kind": "html",
    "content": [
      {
        "from": "css",
        "selector": "main",
        "html": true
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "css",
          "selector": "h1",
          "text": true,
          "transform": [["collapse_ws"]]
        }
      ]
    }
  },
  "_source_url": "https://www.caltech.edu/about/news",
  "_note": "handcrafted: submitted news page has real static article teasers, but the automatic probe treated navigation/sidebar links as article hints and the generated article selector returned 0 chars. Scope rows to div.article-teaser with /about/news/ links and fetch article body from main. robots.txt allows /about/news and declares Crawl-delay: 10."
}
