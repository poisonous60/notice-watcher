{
  "version": 1,
  "site": "gkids.com",
  "board": "news",
  "strategy": "httpx_json",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/json, text/plain, */*",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://gkids.com/news/"
  },
  "timeout": 15,
  "list": {
    "url_template": "https://gkids.com/wp-json/wp/v2/posts?_embed=1",
    "pagination": {
      "kind": "query_param",
      "page_param": "page",
      "size_param": "per_page"
    },
    "page_size_max": 20,
    "list_path": [],
    "fields": {
      "post_id": [
        {
          "from": "json",
          "path": ["id"],
          "transform": [["to_str"]]
        }
      ],
      "title": [
        {
          "from": "json",
          "path": ["title", "rendered"],
          "transform": [["html_unescape"], ["collapse_ws"]]
        }
      ],
      "url": [
        {
          "from": "json",
          "path": ["link"],
          "transform": [["strip_query_fragment"]]
        }
      ],
      "published_at": [
        {
          "from": "json",
          "path": ["date_gmt"],
          "transform": [["iso8601", ["%Y-%m-%dT%H:%M:%S"], "Z"]]
        }
      ],
      "category": [
        {
          "from": "json",
          "path": ["_embedded", "wp:term", 0, 0, "name"],
          "transform": [["collapse_ws"]]
        }
      ],
      "summary": [
        {
          "from": "json",
          "path": ["excerpt", "rendered"],
          "transform": [["html_unescape"], ["collapse_ws"]]
        }
      ],
      "cover_image": [
        {
          "from": "json",
          "path": ["_embedded", "wp:featuredmedia", 0, "source_url"],
          "transform": [["strip_query_fragment"]]
        }
      ]
    }
  },
  "article": {
    "url_template": "https://gkids.com/wp-json/wp/v2/posts/{post_id}",
    "fetch_kind": "json",
    "content": [
      {
        "from": "json",
        "path": ["content", "rendered"]
      }
    ],
    "enrich": {
      "title": [
        {
          "from": "json",
          "path": ["title", "rendered"],
          "transform": [["html_unescape"], ["collapse_ws"]]
        }
      ],
      "published_at": [
        {
          "from": "json",
          "path": ["date_gmt"],
          "transform": [["iso8601", ["%Y-%m-%dT%H:%M:%S"], "Z"]]
        }
      ]
    }
  },
  "_source_url": "https://www.gkids.com/news/",
  "_note": "GKIDS news is a WordPress post archive. The automatic httpx_html config used article.fetch_kind=json, but httpx_html currently parses article responses as HTML; use the WordPress REST list and item endpoints directly."
}
